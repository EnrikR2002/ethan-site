---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrackRecord from "../components/TrackRecord.astro";
import Philosophy from "../components/Philosophy.astro";
import Capabilities from "../components/Capabilities.astro";
import Channels from "../components/Channels.astro";
import CaseStudies from "../components/CaseStudies.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <TrackRecord />
    <hr class="rule wrap-rule" />
    <Philosophy />
    <hr class="rule wrap-rule" />
    <Capabilities />
    <Channels />
    <CaseStudies />
    <CTA />
  </main>
  <Footer />
</Layout>

<style>
  /* section dividers held to the content column */
  .wrap-rule {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
  }
</style>
