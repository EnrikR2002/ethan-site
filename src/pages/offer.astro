---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import offerPreview from "../assets/media/growth-bottleneck-sprint-v6.png";
import { offerPdfUrl, fitCallUrl, sprintOffer } from "../data/consulting";
---

<Layout title="Growth Bottleneck Sprint — One-Page Offer" description="The approved one-page Growth Bottleneck Sprint offer: $2,500, two weeks. View the offer, download the PDF or book a free 20-minute Fit Call.">
  <div class="offer-shell">
    <header class="offer-nav"><a href="/consulting/">← Back to consulting</a><nav aria-label="Offer navigation"><a href="/">Profile</a><a href="/case-studies/">Case studies</a></nav></header>
    <main id="main">
      <div class="offer-heading">
        <div><p class="eyebrow">GROWTH BOTTLENECK SPRINT</p><h1>One-page offer<span>.</span></h1><p>{sprintOffer.priceAndTimeline}</p></div>
        <div class="offer-heading-actions">
          <a class="fit-link" href={fitCallUrl} target="_blank" rel="noopener noreferrer" data-funnel-action="fit-call" data-placement="offer">{sprintOffer.fitCallLabel} <span aria-hidden="true">↗</span></a>
          <a class="pdf-link" href={offerPdfUrl} target="_blank" rel="noopener noreferrer">Open PDF <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="offer-context">This PDF covers the Growth Bottleneck Sprint. Starting from zero or exploring other content and community work? We can scope the right approach on a <a href={fitCallUrl} target="_blank" rel="noopener noreferrer" data-funnel-action="fit-call" data-placement="offer">free Fit Call</a>.</p>
      <div class="offer-preview">
        <a class="preview-document" href={offerPdfUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the Growth Bottleneck Sprint offer PDF">
        <Image src={offerPreview} alt="Approved one-page Growth Bottleneck Sprint offer: one business goal, one customer journey and relevant data; bottleneck diagnosis, prioritized action plan, first test brief and final walkthrough; $2,500 over two weeks; implementation scoped separately." widths={[700, 1100, 1600]} sizes="(min-width: 1184px) 1024px, 100vw" loading="eager" />
        </a>
        <a class="preview-booking" href={fitCallUrl} target="_blank" rel="noopener noreferrer" aria-label="Book a Free 20-Minute Fit Call from the offer preview" data-funnel-action="fit-call" data-placement="offer"><span class="visually-hidden">{sprintOffer.fitCallLabel}</span></a>
      </div>
      <article class="mobile-offer" aria-label="Growth Bottleneck Sprint offer">
        <section class="mobile-intro">
          <p class="eyebrow">THE OFFER</p>
          <h2>Find where your growth is getting stuck<span>.</span></h2>
          <p>You already have attention, users, leads, or customers — but one part of the path to your business goal is underperforming.</p>
          <p>I investigate one critical customer journey, find where it's most likely breaking, and define what to test first.</p>
        </section>
        <section>
          <h3>A focused path forward</h3>
          <ol class="mobile-process">
            <li><strong>Free Fit Call</strong><p>See if there's a real bottleneck worth investigating.</p></li>
            <li><strong>Growth Bottleneck Sprint</strong><p>Diagnose the bottleneck and define the first test.</p></li>
            <li><strong>Run First Test</strong><p>Optional implementation.</p></li>
            <li><strong>Next Decision</strong><p>Use the result to decide what happens next.</p></li>
          </ol>
        </section>
        <section>
          <p class="eyebrow">STEP 1 · THE PRODUCT</p>
          <h3>{sprintOffer.name}</h3>
          <p class="mobile-price">{sprintOffer.priceAndTimeline}</p>
          <p><strong>Find what's breaking — and what to test first.</strong></p>
          <ul class="mobile-focus"><li>One business goal</li><li>One customer journey</li><li>Relevant data + access</li></ul>
          <p>I investigate the journey we chose, identify the bottleneck most likely holding growth back, and define the first experiment worth running.</p>
        </section>
        <section>
          <h3>What you get</h3>
          <p>Everything you need to make the next decision.</p>
          <div class="mobile-deliverable"><h4>01 · Bottleneck diagnosis</h4><p>Where the journey is most likely breaking, why, and what evidence supports it.</p></div>
          <div class="mobile-deliverable"><h4>02 · Prioritized action plan</h4><p>What should change first, why it matters, who owns it, and what we expect to learn.</p></div>
          <div class="mobile-deliverable"><h4>03 · First test brief</h4><p>One defined experiment to test the most important bottleneck: what changes, what stays constant, what needs to be created, who owns it, what we measure, and what decision the result will help you make.</p></div>
          <div class="mobile-deliverable"><h4>04 · Final walkthrough</h4><p>What we know, what we still need to learn, what I'd do first, and what happens next.</p></div>
          <p class="mobile-scope"><strong>Scope:</strong> Investigation · analysis · recommendations · test design · final walkthrough.<br /><strong>Implementation:</strong> Scoped separately after the Sprint.</p>
        </section>
        <section>
          <h3>After the Sprint</h3>
          <h4>Run the first test</h4>
          <p>If you want me to help run the test, I'll scope and price that separately. No ongoing engagement required.</p>
          <h4>Next decision</h4>
          <p>Use the test result to decide what happens next: continue, iterate, change direction, or stop.</p>
        </section>
        <section>
          <h3>Pricing at a glance</h3>
          <dl class="mobile-pricing">
            <div><dt>Free Fit Call <strong>$0</strong></dt><dd>20-min fit + scope decision</dd></div>
            <div><dt>{sprintOffer.name}</dt><dd>Diagnosis + action plan + first test brief<strong>{sprintOffer.priceAndTimeline}</strong></dd></div>
            <div><dt>Run the first test</dt><dd>Implementation scoped separately<strong>Scoped after the Sprint</strong></dd></div>
          </dl>
        </section>
      </article>
      <p class="offer-fallback"><a href={offerPdfUrl} target="_blank" rel="noopener noreferrer">Open the original one-page PDF</a> to zoom in or <a href={offerPdfUrl} download="growth-bottleneck-sprint.pdf">download a copy</a>.</p>
      <div class="offer-next"><a class="fit-link" href={fitCallUrl} target="_blank" rel="noopener noreferrer" data-funnel-action="fit-call" data-placement="offer">{sprintOffer.fitCallLabel} <span aria-hidden="true">↗</span></a><a class="back-link" href="/consulting/">Back to the Sprint details</a></div>
    </main>
  </div>
</Layout>

<style>
  .offer-shell { --paper:#f3f1e9; --ink:#22251f; --subtle:#5d6159; max-width:1184px; margin:auto; padding:0 32px; }
  .offer-nav { min-height:92px; display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:12px; }
  .offer-nav a { display:inline-flex; align-items:center; min-height:44px; text-decoration:none; border-bottom:1px solid #62645d; padding:8px 0; }
  .offer-nav nav { display:flex; gap:24px; }
  main { background:var(--paper); color:var(--ink); border-top:4px solid #ef6543; padding:48px; }
  .offer-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin-bottom:28px; }
  .offer-heading-actions { display:flex; flex-direction:column; align-items:flex-end; gap:10px; flex-shrink:0; }
  .eyebrow { color:#c74325; font-size:10px; font-weight:600; letter-spacing:.13em; margin:0 0 12px; }
  h1 { font-size:clamp(48px,6.5vw,82px); line-height:.96; letter-spacing:-.065em; font-weight:600; margin:0; max-width:12ch; }
  h1 span { color:#c74325; }
  .offer-heading p:last-child { color:var(--subtle); font-size:14px; margin:16px 0 0; }
  .offer-context { color:var(--subtle); font-size:14px; line-height:1.7; max-width:72ch; margin:0 0 24px; }
  .offer-context a { color:var(--ink); text-underline-offset:3px; }
  .pdf-link,.fit-link { display:inline-flex; align-items:center; justify-content:center; gap:22px; background:#ff7956; color:#201a15; min-height:48px; padding:14px 20px; border-radius:3px; text-decoration:none; font-size:12px; font-weight:600; }
  .pdf-link { white-space:nowrap; background:transparent; border:1px solid #a2a79a; }
  .pdf-link:hover { background:#e6e7dc; }
  .fit-link:hover { background:#ff9378; }
  .offer-preview { position:relative; border:1px solid #ced3c2; background:#0c0c0f; }
  .preview-document { display:block; }
  .preview-booking { position:absolute; left:6%; right:6%; bottom:5.27%; height:5.36%; min-height:44px; }
  .preview-booking:hover { box-shadow:inset 0 0 0 3px #fff; }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  .offer-preview img { display:block; width:100%; height:auto; }
  .mobile-offer { display:none; }
  .mobile-offer section { padding:26px 0; border-top:1px solid #d4d7ca; }
  .mobile-offer h2 { margin:0 0 18px; font-size:34px; font-weight:600; line-height:1.08; letter-spacing:-.04em; }
  .mobile-offer h2 span { color:#c74325; }
  .mobile-offer h3 { font-size:22px; font-weight:600; line-height:1.2; letter-spacing:-.025em; margin:0 0 16px; }
  .mobile-offer h4 { font-size:17px; font-weight:600; line-height:1.4; margin:20px 0 8px; }
  .mobile-offer p,.mobile-offer li,.mobile-offer dd { font-size:16px; line-height:1.65; color:var(--subtle); }
  .mobile-offer p { margin:0 0 14px; }
  .mobile-offer strong,.mobile-focus li { color:var(--ink); }
  .mobile-offer .eyebrow { font-size:10px; color:#c74325; }
  .mobile-process { margin:0; padding-left:22px; }
  .mobile-process li { padding-left:6px; margin-bottom:18px; }
  .mobile-process p { margin:3px 0 0; }
  .mobile-focus { padding-left:20px; margin:18px 0; }
  .mobile-offer .mobile-price { color:#c74325; font-weight:600; }
  .mobile-deliverable { border-top:1px solid #d4d7ca; padding-bottom:8px; }
  .mobile-offer .mobile-scope { border-left:3px solid #ef6543; padding-left:14px; margin:16px 0 0; }
  .mobile-pricing { margin:0; }
  .mobile-pricing div { border-top:1px solid #d4d7ca; padding:18px 0; }
  .mobile-pricing dt { font-size:16px; font-weight:600; line-height:1.5; }
  .mobile-pricing dt strong { float:right; }
  .mobile-pricing dd { margin:6px 0 0; }
  .mobile-pricing dd strong { display:block; margin-top:8px; color:#c74325; }
  .offer-fallback { color:var(--subtle); font-size:12px; line-height:1.6; margin:14px 0 0; }
  .offer-fallback a,.back-link { color:var(--ink); text-underline-offset:3px; }
  .offer-next { margin-top:28px; padding-top:24px; border-top:1px solid #d4d7ca; display:flex; align-items:center; flex-wrap:wrap; gap:12px 24px; }
  .back-link { display:inline-flex; align-items:center; min-height:44px; font-size:12px; }
  main a:focus-visible { outline:3px solid #c74325; outline-offset:4px; }
  @media(max-width:700px) { .offer-shell { padding:0 16px; } .offer-nav { min-height:72px; gap:12px; } .offer-nav nav { gap:16px; } main { padding:28px 24px; } .offer-heading { display:block; } .offer-heading-actions { align-items:stretch; margin-top:22px; } .offer-preview { display:none; } .mobile-offer { display:block; } .offer-next { display:block; } .fit-link { display:flex; padding-inline:12px; gap:12px; text-align:center; } .back-link { margin-top:10px; } }
  @media(max-width:370px) { main { padding:24px 18px; } .offer-nav { font-size:11px; } .offer-nav nav { gap:12px; } }
</style>
