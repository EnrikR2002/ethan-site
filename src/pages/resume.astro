---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import resumePreview from "../assets/media/ethan-resume-oct-2026.png";
---

<Layout title="Ethan Alfandary — Résumé" description="Ethan Alfandary's one-page résumé, with experience in audience growth, content strategy and AI workflows.">
  <div class="resume-shell">
    <header class="resume-nav"><a href="/">← Back to profile</a><a href="/consulting">Consulting ↗</a></header>
    <main id="main">
      <div class="resume-heading">
        <div><p class="eyebrow">THE FULL OVERVIEW</p><h1>Résumé<span>.</span></h1><p>Roles, projects and results in one page.</p></div>
        <a class="pdf-link" href="/ethan-alfandary-resume.pdf" target="_blank" rel="noopener noreferrer">Open PDF <span aria-hidden="true">↗</span></a>
      </div>
      <a class="resume-preview" href="/ethan-alfandary-resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open Ethan Alfandary's résumé PDF">
        <Image src={resumePreview} alt="Preview of Ethan Alfandary's one-page résumé" widths={[700, 1100, 1600]} sizes="(min-width: 1184px) 1024px, 100vw" loading="eager" />
      </a>
      <p class="resume-fallback">Tap the page or <a href="/ethan-alfandary-resume.pdf" target="_blank" rel="noopener noreferrer">open the original PDF</a> to zoom in.</p>
    </main>
  </div>
</Layout>

<style>
  .resume-shell { --paper:#f3f1e9; --ink:#22251f; --subtle:#5d6159; max-width:1184px; margin:auto; padding:0 32px; }
  .resume-nav { min-height:92px; display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:12px; }
  .resume-nav a { text-decoration:none; border-bottom:1px solid #62645d; padding:8px 0; }
  main { background:var(--paper); color:var(--ink); border-top:4px solid #ef6543; padding:48px; }
  .resume-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin-bottom:28px; }
  .eyebrow { color:#c74325; font-size:10px; font-weight:600; letter-spacing:.13em; margin:0 0 12px; }
  h1 { font-size:clamp(48px,6.5vw,82px); line-height:.96; letter-spacing:-.065em; font-weight:600; margin:0; }
  h1 span { color:#c74325; }
  .resume-heading p:last-child { color:var(--subtle); font-size:14px; margin:16px 0 0; }
  .pdf-link { display:inline-flex; align-items:center; justify-content:center; gap:22px; background:#ff7956; color:#201a15; min-height:48px; padding:14px 20px; border-radius:3px; text-decoration:none; font-size:12px; font-weight:600; white-space:nowrap; }
  .pdf-link:hover { background:#ff9378; }
  .resume-preview { display:block; border:1px solid #ced3c2; background:#fff; }
  .resume-preview img { display:block; width:100%; height:auto; }
  .resume-fallback { color:var(--subtle); font-size:12px; line-height:1.6; margin:14px 0 0; }
  .resume-fallback a { color:var(--ink); text-underline-offset:3px; }
  main a:focus-visible { outline:3px solid #c74325; outline-offset:4px; }
  @media(max-width:700px) { .resume-shell { padding:0 16px; } .resume-nav { min-height:72px; } main { padding:28px 24px; } .resume-heading { display:block; } .pdf-link { margin-top:22px; } }
  @media(max-width:370px) { main { padding:24px 18px; } }
</style>
