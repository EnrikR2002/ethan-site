---
const links = [
  { href: "#taste", label: "Philosophy" },
  { href: "#services", label: "Services" },
  { href: "#canvas", label: "Highlights" },
  { href: "#case-studies", label: "Work" },
  { href: "#cta", label: "Contact" },
];
---

<header
  class="sticky top-0 z-50 bg-[#0a0a0c]/80 backdrop-blur-md border-b border-white/[0.06]"
>
  <nav
    class="container flex items-center justify-between py-3.5 px-2 md:px-4 lg:px-6"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/media/syfer_logo.png"
        alt="Syfer logo"
        class="w-10 h-10 object-contain rounded-lg"
      />
      <span class="font-bold text-sm tracking-wide text-white">ETHAN ALFANDARY</span>
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {
        links.map((l) => (
          <li>
            <a
              class="text-sm text-zinc-400 hover:text-white transition-colors focus:outline-none focus-visible:text-white"
              href={l.href}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="https://calendly.com/miningspartan2"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-nav hidden md:inline-flex"
    >
      Book a call
    </a>
  </nav>
</header>
