---
const STATS = [
  {
    head: "2× YouTube Silver Play Buttons",
    caption: "Music Promotion & Gaming Video Editing",
  },
  {
    head: "425% YouTube growth",
    caption: "Medical brand in under a year (8K → 42K)",
  },
  {
    head: "120M+ views",
    caption: "UFC/MMA content verticals",
  },
  {
    head: "45M+ long-form views",
    caption: "Gaming channels",
  },
  {
    head: "330K+ Twitter followers",
    caption: "Built in the Breakcore/Music niche",
  },
  {
    head: "24M+ views",
    caption: "Medical vertical alone",
  },
];
---

<style>
  .stats-list {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .stats-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .stats-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .stat-pill {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .stat-head {
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.25;
    color: #ffffff;
  }
  .stat-caption {
    font-size: 0.9rem;
    color: #a1a1aa;
  }
</style>

<ul class="stats-list" aria-label="Key results">
  {
    STATS.map((s) => (
      <li class="card stat-pill" role="listitem">
        <div class="stat-head">{s.head}</div>
        <div class="stat-caption">{s.caption}</div>
      </li>
    ))
  }
</ul>
