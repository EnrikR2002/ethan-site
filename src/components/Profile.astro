---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { meta } from "../data/site";
import { proof, caseStudies, resultsAsOf } from "../data/results";
import awards from "../assets/media/playbuttons.jpg";
import mark from "../assets/media/syfer-mark.png";
interface Props { event?: boolean }
const { event = false } = Astro.props;
const topics = ["AI content workflows", "YouTube growth & retention", "Competitive content research", "Music & online communities", "Creative teams & production"];
---

<Layout title={`${meta.name} — ${event ? "SF Tech Week · " : ""}Content, Growth & AI`}>
  <div class="profile-shell">
    <header class="profile-nav">
      <a class="wordmark" href="/" aria-label="Ethan Alfandary home"><Image src={mark} alt="" width={28} height={28} />SYFER<span> / ETHAN ALFANDARY</span></a>
      <a href="/consulting">Consulting <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main" class="profile-sheet">
      {event && <div class="event-banner"><span class="event-dot" aria-hidden="true"></span> SF TECH WEEK <span class="event-divider">/</span> A quick introduction. A good place to start.</div>}
      <div class="profile-intro">
        <div class="intro-heading">
          <p class="eyebrow">MEET ETHAN <span>LOS ANGELES, CA</span></p>
          <h1>Ethan<br />Alfandary<span class="name-period">.</span></h1>
          <p class="position">Founder, Syfer Media<br /><span>Audience Growth & AI Content Strategy</span></p>
        </div>
        <div class="intro-note">
          <span class="note-symbol" aria-hidden="true">↗</span>
          <p>I build audiences. <br />And the systems <br />that help them grow.</p>
          <a class="text-link" href="#case-studies">A few examples below <span aria-hidden="true">↓</span></a>
        </div>
        <p class="profile-objective"><strong>Objective:</strong> Seeking to help ambitious brands grow through AI-assisted content strategy, audience intelligence, and performance marketing—turning creative work into measurable audience and business growth.</p>
      </div>

      <div class="profile-body">
        <aside class="identity" aria-label="Highlights and contact">
          <figure class="award-photo">
            <Image src={awards} alt="YouTube Silver Play Buttons awarded to Syfer Music and Yamikaze for reaching 100,000 subscribers" widths={[400, 720]} sizes="(min-width: 760px) 320px, 90vw" loading="eager" />
            <figcaption><span>Two channels. Two milestones.</span>Music & gaming · YouTube Silver Play Buttons</figcaption>
          </figure>
          <div class="identity-proof"><strong>{proof.overallViews}</strong><span>views across my work</span></div>
          <p class="identity-caption">A decade working across music, gaming, healthcare and online communities.</p>
          <div class="contact-block" id="connect">
            <p class="eyebrow">LET’S CONNECT</p>
            <a href={meta.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${meta.email}`}>Email Ethan <span aria-hidden="true">↗</span></a>
            <span class="email-address">{meta.email}</span>
          </div>
        </aside>

        <div class="profile-story">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading">About</h2>
            <p>I got my start in music, co-founding Syfer Music in 2014 and building an independent music community that connected artists with new audiences. Since then, I’ve led content and growth work across gaming, MMA and healthcare—recruiting, managing and training editors, and working with a surgeon and her staff to integrate AI into their practice.</p>
            <p>Today I run Syfer Media. I focus on audience research, content strategy and practical AI workflows that creative teams can use consistently.</p>
          </section>
          <section class="topics" aria-labelledby="topics-heading">
            <h2 id="topics-heading">Ask me about</h2>
            <ul>{topics.map((topic) => <li>{topic}</li>)}</ul>
          </section>
          <section class="selected-work" aria-labelledby="projects-heading">
            <h2 id="projects-heading">A few things I’ve built</h2>
            <ul class="project-list">
              <li><h3>Syfer Media <span>Founder</span></h3><p>Grew Tansavatdi Facial Plastic Surgery’s YouTube channel from <strong>{proof.medical.from} to {proof.medical.to} subscribers (+{proof.medical.growth})</strong> and helped generate <strong>{proof.medical.views} views</strong>. I also build content research systems and train teams to use AI in production.</p></li>
              <li><h3>Syfer Music & Silver Skies <span>Co-founder</span></h3><p><strong>{proof.music.subscribers} subscribers · {proof.music.views} views</strong><br />Supporting {proof.music.artists} artists and {proof.music.releases} releases, with a {proof.music.discord}-member Discord community.</p></li>
              <li><h3>MemesBreakcore <span>Founder</span></h3><p><strong>X: {proof.breakcore.from} → {proof.breakcore.to} followers in {proof.breakcore.growthMonths} (+{proof.breakcore.growth})</strong><br />Instagram: {proof.breakcore.instagram} followers · Reddit: {proof.breakcore.reddit} subscribers · Spotify playlist: {proof.breakcore.playlistSaves} saves.</p></li>
            </ul>
          </section>
          <p class="personal-note"><span>Off the clock</span> EDM, music curation, boxing and anime. Taekwondo black belt and former rugby player. Always up for a good conversation.</p>
        </div>
      </div>

      <section class="profile-cases" id="case-studies" aria-labelledby="cases-heading">
        <div class="cases-heading"><div><p class="eyebrow">THE WORK, IN BRIEF</p><h2 id="cases-heading">Case studies</h2></div><p>{resultsAsOf}</p></div>
        <div class="case-grid">
          {caseStudies.map((item) => <article class="mini-case">
            <p class="case-kicker"><span>{item.index}</span>{item.client}</p>
            <h3>{item.title}</h3>
            <p class="case-role">{item.role}</p>
            <p class="case-summary">{item.system}</p>
            <p class="case-change">{item.change}</p>
            <dl class="mini-metrics">{item.results.map((result) => <div><dt>{result.label}</dt><dd>{result.value}</dd></div>)}</dl>
            <p class="case-detail">{item.detail}</p>
          </article>)}
        </div>
        <p class="results-note">Figures reflect work on each project; project totals may overlap. Growth percentages use the stated starting and ending counts where available.</p>
      </section>

      <section class="profile-next" aria-labelledby="next-heading">
        <div><p class="eyebrow">LET’S PUT THIS TO WORK</p><h2 id="next-heading">Have something<br />you want to grow?</h2><p>Explore how I work with creators, brands and teams.</p></div>
        <div class="next-actions"><a class="profile-button" href="/consulting" data-funnel-action="consulting">See my work & consulting <span aria-hidden="true">↗</span></a><a class="resume-link" href="/resume">View my résumé <span aria-hidden="true">↗</span></a><a href={`mailto:${meta.email}`} class="text-link">Or start a conversation <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <footer class="profile-footer"><span>© {new Date().getFullYear()} Ethan Alfandary · Syfer Media</span><a href="#main">Back to top ↑</a></footer>
  </div>

  <dialog class="resume-dialog" aria-labelledby="resume-dialog-title" data-resume-dialog>
    <form method="dialog"><button class="dialog-close" aria-label="Close résumé prompt">×</button></form>
    <p class="eyebrow">FULL RÉSUMÉ</p>
    <h2 id="resume-dialog-title">Want the full résumé?</h2>
    <p>See the one-page overview of my roles, projects and results.</p>
    <div class="dialog-actions">
      <a class="profile-button" href="/resume">View résumé <span aria-hidden="true">↗</span></a>
      <form method="dialog"><button class="dialog-later">Keep exploring</button></form>
    </div>
  </dialog>
</Layout>

<script is:inline>
  const resumeDialog = document.querySelector("[data-resume-dialog]");
  const resumeSection = document.querySelector(".profile-footer");
  const seenKey = "syfer-resume-prompt-seen";
  const openResumePrompt = () => {
    if (!resumeDialog || resumeDialog.open) return;
    try { sessionStorage.setItem(seenKey, "1"); } catch (_) {}
    resumeDialog.showModal();
  };
  if (resumeSection && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      let seen = false;
      try { seen = sessionStorage.getItem(seenKey) === "1"; } catch (_) {}
      if (!seen) openResumePrompt();
    }, { threshold: 0.55 });
    observer.observe(resumeSection);
  }
</script>

<style>
  .profile-shell { --paper:#f3f1e9; --ink:#22251f; --subtle:#5d6159; --rule:#d4d7ca; --orange:#c74325; max-width:1184px; margin:auto; padding:0 32px; }
  .profile-nav { min-height:92px; display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:12px; }
  .profile-nav a { text-decoration:none; }
  .wordmark { display:flex; align-items:center; gap:10px; font-weight:600; letter-spacing:.1em; }
  .wordmark img { filter:invert(1); }
  .wordmark span { color:#a7aaa4; font-size:10px; font-weight:400; }
  .profile-nav > a:last-child { color:#e5e5da; border-bottom:1px solid #62645d; padding:8px 0; }
  .profile-nav > a:last-child span { margin-left:14px; color:#ff7959; }
  .profile-sheet { background:var(--paper); color:var(--ink); border-top:4px solid #ef6543; }
  .profile-sheet a:focus-visible { outline:3px solid var(--orange); outline-offset:5px; }
  .event-banner { background:#e5e8da; border-bottom:1px solid var(--rule); padding:14px 48px; display:flex; align-items:center; gap:10px; font-size:11px; letter-spacing:.06em; flex-wrap:wrap; }
  .event-dot { width:7px; height:7px; border-radius:50%; background:var(--orange); }
  .event-divider { opacity:.4; margin:0 6px; }
  .profile-intro { display:grid; grid-template-columns:1.3fr 1fr; column-gap:40px; row-gap:24px; padding:48px 48px 40px; border-bottom:1px solid var(--rule); }
  .eyebrow { font-size:10px; font-weight:600; letter-spacing:.13em; line-height:1.5; color:var(--orange); margin:0 0 18px; }
  .intro-heading .eyebrow { display:flex; gap:28px; }
  .eyebrow span { color:var(--subtle); }
  h1 { font-size:clamp(48px,6.5vw,82px); line-height:.96; letter-spacing:-.065em; font-weight:600; margin:0; }
  .name-period { color:var(--orange); }
  .position { font-size:15px; line-height:1.7; margin:22px 0 0; font-weight:600; }
  .position span { color:var(--subtle); font-weight:400; }
  .profile-objective { grid-column:1 / -1; max-width:860px; margin:0; font-size:13px; line-height:1.8; color:var(--subtle); }
  .profile-objective strong { color:var(--ink); font-weight:600; }
  .intro-note { border-left:1px solid var(--rule); padding-left:40px; align-self:stretch; display:flex; flex-direction:column; justify-content:center; }
  .note-symbol { color:var(--orange); font-size:32px; line-height:1; }
  .intro-note > p { font-size:clamp(22px,2.4vw,30px); letter-spacing:-.04em; line-height:1.3; margin:18px 0 22px; }
  .text-link { font-size:12px; text-decoration:underline; text-underline-offset:5px; font-weight:500; }
  .text-link span { margin-left:8px; }
  .profile-body { display:grid; grid-template-columns:280px minmax(0,1fr); gap:56px; padding:40px 48px 48px; }
  .award-photo { margin:0; }
  .award-photo img { display:block; width:100%; height:auto; aspect-ratio:1.1; object-fit:cover; border-radius:2px; }
  figcaption { font-size:10px; line-height:1.6; color:var(--subtle); margin-top:10px; }
  figcaption span { display:block; font-weight:600; color:var(--ink); }
  .identity-proof { margin-top:28px; padding-top:24px; border-top:1px solid var(--rule); }
  .identity-proof strong { display:block; font-size:48px; letter-spacing:-.06em; line-height:1; font-weight:600; }
  .identity-proof > span { font-size:12px; display:block; margin-top:8px; }
  .identity-caption { font-size:12px; color:var(--subtle); line-height:1.7; margin:14px 0 0; max-width:230px; }
  .contact-block { margin-top:28px; padding-top:24px; border-top:1px solid var(--rule); }
  .contact-block .eyebrow { margin-bottom:10px; }
  .contact-block a { display:flex; justify-content:space-between; align-items:center; font-size:13px; min-height:44px; text-decoration:none; border-bottom:1px solid var(--rule); }
  .contact-block a:hover { color:var(--orange); }
  .email-address { display:block; font-size:10px; color:var(--subtle); margin-top:12px; overflow-wrap:anywhere; }
  .profile-story h2 { font-size:19px; font-weight:600; line-height:1.3; letter-spacing:-.04em; margin:0 0 14px; }
  .profile-story p { font-size:13px; line-height:1.8; color:var(--subtle); margin:0 0 12px; }
  .profile-story section + section { margin-top:26px; padding-top:24px; border-top:1px solid var(--rule); }
  .topics ul { display:flex; flex-wrap:wrap; list-style:none; padding:0; margin:0; gap:8px; }
  .topics li { padding:7px 10px; border:1px solid #c9cebf; border-radius:3px; font-size:11px; background:#eceee3; }
  .project-list { list-style:none; padding:0; margin:0; display:grid; gap:18px; }
  .project-list h3 { font-size:13px; font-weight:600; line-height:1.6; margin:0 0 3px; }
  .project-list h3 span { font-size:10px; font-weight:400; color:var(--subtle); margin-left:8px; white-space:nowrap; }
  .project-list p { font-size:12px; margin:0; }
  .project-list strong { font-weight:500; color:var(--ink); }
  .profile-story .personal-note { margin:24px 0 0; padding:16px 0 0; border-top:1px solid var(--rule); font-size:11px; }
  .personal-note span { display:block; color:var(--orange); font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.1em; margin-bottom:3px; }
  .profile-cases { padding:40px 48px; border-top:1px solid var(--rule); background:#e8ebdf; scroll-margin-top:20px; }
  .cases-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:28px; }
  .cases-heading .eyebrow { margin-bottom:12px; }
  .cases-heading h2,.profile-next h2 { font-size:32px; line-height:1.1; letter-spacing:-.045em; font-weight:500; margin:0; }
  .cases-heading > p { font-size:10px; max-width:150px; color:var(--subtle); margin:0; }
  .case-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .mini-case { background:var(--paper); border:1px solid #ced3c2; padding:24px; }
  .case-kicker { font-size:10px; color:var(--subtle); display:flex; align-items:baseline; gap:12px; line-height:1.5; margin:0 0 18px; }
  .case-kicker span { color:var(--orange); font-variant-numeric:tabular-nums; }
  .mini-case h3 { font-size:21px; line-height:1.2; letter-spacing:-.04em; margin:0 0 6px; font-weight:600; }
  .case-role { font-size:10px; color:var(--subtle); margin:0 0 16px; }
  .case-summary { font-size:12px; line-height:1.7; margin:0 0 18px; color:var(--subtle); }
  .case-change { font-size:12px; font-weight:600; margin:0 0 14px; }
  .mini-metrics { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:0; padding:16px 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); }
  .mini-metrics > div { display:flex; flex-direction:column-reverse; }
  .mini-metrics dt { font-size:10px; color:var(--subtle); margin-top:5px; }
  .mini-metrics dd { font-size:34px; line-height:1; font-weight:500; letter-spacing:-.05em; margin:0; }
  .case-detail { font-size:10px; line-height:1.7; color:var(--subtle); margin:14px 0 0; }
  .results-note { font-size:10px; line-height:1.7; color:var(--subtle); max-width:700px; margin:18px 0 0; }
  .profile-next { padding:40px 48px; background:#252a22; color:#f3f1e9; display:flex; align-items:center; justify-content:space-between; gap:32px; }
  .profile-next .eyebrow { color:#ff967c; margin-bottom:12px; }
  .profile-next p:last-child { color:#c1c6b9; font-size:12px; margin:14px 0 0; }
  .next-actions { display:flex; flex-direction:column; align-items:center; gap:20px; }
  .profile-button { display:flex; align-items:center; justify-content:center; gap:24px; background:#ff7956; color:#201a15; padding:17px 21px; border-radius:3px; text-decoration:none; font-size:12px; font-weight:600; min-height:48px; }
  .profile-button:hover { background:#ff9378; }
  .resume-link { border-bottom:1px solid #c1c6b9; padding:0 0 5px; color:#f3f1e9; font-size:12px; text-decoration:none; }
  .resume-link:hover { color:#ff967c; }
  .resume-dialog { position:fixed; inset:0; margin:auto; width:min(440px,calc(100vw - 32px)); max-height:calc(100vh - 32px); padding:32px; border:1px solid #cbd0c2; border-top:4px solid #ef6543; background:#f3f1e9; color:#22251f; box-shadow:0 24px 70px #0008; }
  .resume-dialog::backdrop { background:rgba(12,16,13,.62); }
  .resume-dialog .eyebrow { margin-bottom:12px; }
  .resume-dialog h2 { font-size:30px; line-height:1.1; letter-spacing:-.045em; font-weight:600; margin:0; }
  .resume-dialog > p:not(.eyebrow) { font-size:14px; line-height:1.6; color:#5d6159; margin:14px 0 24px; }
  .dialog-close { position:absolute; top:14px; right:16px; border:0; background:none; font-size:26px; line-height:1; color:#5d6159; cursor:pointer; }
  .dialog-actions { display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
  .dialog-later { border:0; background:none; color:#5d6159; font:inherit; font-size:12px; text-decoration:underline; text-underline-offset:4px; cursor:pointer; }
  .resume-dialog button:focus-visible,.resume-dialog a:focus-visible,.resume-link:focus-visible { outline:3px solid #c74325; outline-offset:4px; }
  .profile-footer { display:flex; justify-content:space-between; gap:20px; padding:24px 0 32px; font-size:10px; color:#a8ada3; }
  .profile-footer a { text-decoration:none; }
  @media(max-width:900px) { .profile-body { grid-template-columns:220px minmax(0,1fr); gap:32px; } .profile-intro,.profile-body,.profile-cases,.profile-next { padding-left:32px; padding-right:32px; } .intro-note { padding-left:28px; } }
  @media(max-width:700px) {
    .profile-shell { padding:0 16px; } .profile-nav { min-height:72px; } .wordmark span { display:none; }
    .profile-intro { grid-template-columns:1fr; gap:24px; padding:28px 24px; } h1 { font-size:60px; }
    .profile-objective { font-size:14px; line-height:1.7; }
    .intro-note { border-left:0; border-top:1px solid var(--rule); padding:20px 0 0; } .note-symbol { display:none; }
    .intro-note > p { font-size:23px; margin:0 0 16px; } .intro-note > p br { display:none; } .intro-note > p br::after { content:' '; }
    .profile-body { display:flex; flex-direction:column; padding:28px 24px; gap:32px; }
    .identity { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; } .award-photo { grid-row:span 2; }
    .identity-proof { border:0; padding:0; margin:0; } .identity-proof strong { font-size:38px; } .identity-proof > span { font-size:10px; }
    .identity-caption { margin:0; font-size:11px; } .contact-block { grid-column:1 / -1; margin-top:6px; padding-top:16px; }
    .email-address { display:none; } .profile-story p { font-size:14px; } .project-list p { font-size:13px; }
    .profile-cases { padding:28px 24px; } .cases-heading { display:block; } .cases-heading > p { max-width:none; margin-top:14px; }
    .case-grid { grid-template-columns:1fr; } .mini-case { padding:20px; } .case-summary { font-size:13px; }
    .profile-next { padding:28px 24px; display:block; } .next-actions { align-items:stretch; margin-top:26px; text-align:center; }
    .profile-footer { flex-wrap:wrap; font-size:9px; } .event-banner { padding:14px 24px; font-size:10px; } .resume-dialog { padding:26px; }
  }
  @media(max-width:370px) { h1 { font-size:50px; } .profile-intro,.profile-body,.profile-cases,.profile-next { padding-left:18px; padding-right:18px; } .mini-case { padding:16px; } .mini-metrics dd { font-size:29px; } .profile-button { gap:12px; padding-inline:12px; } .identity { grid-template-columns:1fr; } .award-photo { grid-row:auto; } .identity-caption { max-width:none; } }
</style>
