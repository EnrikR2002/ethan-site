---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { channels } from "../data/site";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/media/*.{png,PNG,jpg,jpeg,JPG}",
  { eager: true },
);

/**
 * Each source is a full profile screenshot. Rather than show that chrome, we
 * position the image inside a circular window so only the avatar is visible.
 *
 * For a square crop of size `c` at (x, y) within a `w × h` source:
 *   background-size     = 100·w/c %  ,  100·h/c %
 *   background-position = 100·x/(w−c) % , 100·y/(h−c) %
 * which holds at any rendered avatar size.
 */
const items = await Promise.all(
  channels.map(async (ch) => {
    const mod = files[`../assets/media/${ch.source}`];
    if (!mod) throw new Error(`Missing channel asset: ${ch.source}`);

    const [w, h] = ch.img;
    const [x, y, c] = ch.crop;

    const optimized = await getImage({
      src: mod.default,
      width: Math.min(w, 700),
      format: "webp",
    });

    return {
      ...ch,
      src: optimized.src,
      sizeX: ((100 * w) / c).toFixed(2),
      sizeY: ((100 * h) / c).toFixed(2),
      posX: ((100 * x) / (w - c)).toFixed(2),
      posY: ((100 * y) / (h - c)).toFixed(2),
    };
  }),
);

// Rendered twice so the marquee can wrap seamlessly. The second pass is
// hidden from assistive tech and removed from the tab order.
const loop = [
  ...items.map((it) => ({ ...it, clone: false })),
  ...items.map((it) => ({ ...it, clone: true })),
];
---

<section class="section channels" id="channels">
  <div class="wrap">
    <div class="channels__head">
      <div>
        <p class="label label--line js-observe">Highlights</p>
        <h2 class="h2 channels__title">
          Channels I've <span class="accent">built &amp; scaled.</span>
        </h2>
      </div>
      <p class="channels__hint" aria-hidden="true">Drag to explore</p>
    </div>

    <div
      class="channels__viewport"
      data-marquee
      role="region"
      aria-label="Channels built and scaled"
    >
      <ul class="channels__track" data-marquee-track>
        {
          loop.map((ch) => (
            <li class="channel" aria-hidden={ch.clone ? "true" : undefined}>
              <a
                class="channel__link"
                href={ch.href}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={ch.clone ? -1 : undefined}
              >
                <span
                  class="channel__avatar"
                  style={`background-image:url(${ch.src});background-size:${ch.sizeX}% ${ch.sizeY}%;background-position:${ch.posX}% ${ch.posY}%;`}
                  aria-hidden="true"
                />
                <span class="channel__meta">
                  <span class="channel__platform">{ch.platform}</span>
                  <span class="channel__name">{ch.name}</span>
                  <span class="channel__handle">{ch.handle}</span>
                </span>
                <span class="channel__stats">
                  <span class="channel__stat">{ch.stat}</span>
                  <span class="channel__detail">{ch.detail}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .channels__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .channels__title {
    margin-top: 18px;
    max-width: 16ch;
  }

  .channels__hint {
    display: none;
    margin: 0;
    font-size: var(--t-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  /* Aligned to the content grid, not full-bleed, so the first card lines up
     with the heading above it. */
  .channels__viewport {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    /* soften both ends so cards enter and leave rather than being clipped */
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .channels__track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    will-change: transform;
  }

  .channels__viewport.is-dragging {
    cursor: grabbing;
  }

  .channels__viewport.is-dragging .channel__link {
    pointer-events: none;
  }

  .channel {
    flex: 0 0 auto;
    border-right: 1px solid var(--line);
  }

  .channel__link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "avatar meta"
      "stats  stats";
    align-items: center;
    gap: 14px;
    /* sized so roughly three cards sit in view at desktop widths */
    width: clamp(290px, 33vw, 400px);
    height: 100%;
    padding: 22px 24px 20px;
    text-decoration: none;
    transition: background-color 200ms var(--ease);
  }

  .channel__link:hover {
    background: rgba(255, 255, 255, 0.022);
  }

  .channel__avatar {
    grid-area: avatar;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-repeat: no-repeat;
    background-color: var(--bg-raised);
    border: 1px solid var(--line);
    flex: none;
  }

  .channel__meta {
    grid-area: meta;
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .channel__platform {
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .channel__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .channel__handle {
    font-size: var(--t-label);
    color: var(--fg-muted);
  }

  .channel__stats {
    grid-area: stats;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .channel__stat {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    font-variant-numeric: tabular-nums;
  }

  .channel__detail {
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 720px) {
    .channels__hint {
      display: block;
    }

    .channel__link {
      cursor: grab;
    }
  }

  /* No autoplay: fall back to a plain scroller the reader drives. */
  @media (prefers-reduced-motion: reduce) {
    .channels__viewport {
      overflow-x: auto;
    }

    .channels__track {
      transform: none !important;
    }
  }
</style>

<script>
  /* @ts-nocheck */
  document.querySelectorAll("[data-marquee]").forEach((viewport) => {
    const track = viewport.querySelector("[data-marquee-track]");
    if (!track) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const SPEED = 34; // px per second, leftward
    let setWidth = 0; // width of one copy of the list
    let offset = 0;
    let paused = false;
    let dragging = false;
    let pointerId = null;
    let startX = 0;
    let startOffset = 0;
    let moved = 0;
    let last = performance.now();
    let raf = 0;

    const measure = () => {
      setWidth = track.scrollWidth / 2;
    };

    const wrap = () => {
      if (setWidth <= 0) return;
      // keep offset within one set so the loop is seamless in both directions
      while (offset <= -setWidth) offset += setWidth;
      while (offset > 0) offset -= setWidth;
    };

    const draw = () => {
      track.style.transform = `translate3d(${offset}px, 0, 0)`;
    };

    const tick = (now) => {
      const dt = Math.min((now - last) / 1000, 0.05); // clamp after tab switches
      last = now;
      if (!paused && !dragging && setWidth > 0) {
        offset -= SPEED * dt;
        wrap();
        draw();
      }
      raf = requestAnimationFrame(tick);
    };

    viewport.addEventListener("pointerenter", () => (paused = true));
    viewport.addEventListener("pointerleave", () => (paused = false));
    viewport.addEventListener("focusin", () => (paused = true));
    viewport.addEventListener("focusout", () => (paused = false));

    viewport.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = 0;
      pointerId = e.pointerId;
      startX = e.clientX;
      startOffset = offset;
      viewport.setPointerCapture(pointerId);
    });

    viewport.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      moved = Math.abs(dx);
      // only claim the gesture once it is clearly a drag, so clicks still work
      if (moved > 4) viewport.classList.add("is-dragging");
      offset = startOffset + dx;
      wrap();
      draw();
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove("is-dragging");
      if (pointerId !== null && viewport.hasPointerCapture(pointerId)) {
        viewport.releasePointerCapture(pointerId);
      }
      pointerId = null;
    };

    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);

    // pause while off-screen so we are not animating for nobody
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          paused = !entry.isIntersecting;
          last = performance.now();
        },
        { threshold: 0 },
      ).observe(viewport);
    }

    new ResizeObserver(() => {
      measure();
      wrap();
      draw();
    }).observe(track);

    measure();
    draw();
    raf = requestAnimationFrame(tick);
  });
</script>
