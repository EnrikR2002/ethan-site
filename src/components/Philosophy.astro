---
import { Image } from "astro:assets";
import { philosophy } from "../data/site";
import mark from "../assets/media/syfer-mark.png";
---

<section class="section philosophy" id="philosophy">
  <Image
    src={mark}
    alt=""
    width={720}
    class="philosophy__watermark"
    aria-hidden="true"
    loading="lazy"
  />

  <div class="wrap grid12 philosophy__inner">
    <div class="philosophy__head">
      <p class="label label--line js-observe">Philosophy</p>
    </div>

    <div class="philosophy__thesis reveal">
      <h2 class="h2">
        Taste is the <span class="accent">Multiplier.</span>
      </h2>
      <p class="philosophy__pull">{philosophy.thesis}</p>
    </div>

    <div class="philosophy__body reveal" data-delay="2">
      {philosophy.body.map((p) => <p class="philosophy__para">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .philosophy {
    position: relative;
    overflow: hidden;
  }

  /* Oversized mark, kept almost invisible */
  .philosophy__watermark {
    position: absolute;
    left: clamp(-180px, -12vw, -80px);
    top: 50%;
    transform: translateY(-50%);
    width: clamp(320px, 40vw, 640px);
    height: auto;
    filter: invert(1);
    opacity: 0.028;
    pointer-events: none;
    user-select: none;
  }

  .philosophy__inner {
    position: relative;
    row-gap: clamp(28px, 4vw, 44px);
  }

  .philosophy__head {
    grid-column: 1 / -1;
  }

  .philosophy__thesis {
    grid-column: 1 / -1;
  }

  .philosophy__pull {
    margin: 20px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--fg);
    max-width: 30ch;
    text-wrap: pretty;
  }

  .philosophy__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 18px;
  }

  .philosophy__para {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.72;
    color: var(--fg-muted);
    max-width: 68ch;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .philosophy__head {
      grid-column: 1 / span 2;
      padding-top: 6px;
    }

    .philosophy__thesis {
      grid-column: 3 / span 5;
    }

    .philosophy__body {
      grid-column: 8 / span 5;
      gap: 20px;
    }
  }
</style>
