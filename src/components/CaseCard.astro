---
const {
  href = "#",
  title,
  metric,
  thumb = "/media/sample-1.jpg",
} = Astro.props;
---

<a href={href} class="group block card overflow-hidden">
  <div class="overflow-hidden">
    <img
      src={thumb}
      alt={title}
      class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="p-5">
    <h3 class="font-semibold text-lg text-white">{title}</h3>
    {metric && <p class="text-sm mt-1 text-brand-400">{metric}</p>}
  </div>
</a>
